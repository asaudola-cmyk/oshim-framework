#!/bin/bash
# 👑 Sovereign OSHIM Launcher
# WHY: Direct gateway to the native bare-metal Zend VM SAPI binary.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BINARY="${SCRIPT_DIR}/sapi/oshim/oshim"

if [ ! -f "$BINARY" ]; then
    echo -e "\033[1;31m[OSHIM Error]\033[0m Native SAPI binary not found at ${BINARY}. Please compile first." >&2
    exit 1
fi

exec "$BINARY" "$@"
